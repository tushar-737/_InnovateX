# ---- LLM (optional but recommended) ---------------------------------------
# Backend-only. NEVER put this in frontend code. If empty, Kaushal Saathi runs
# on its built-in Hindi rule-based dialogue engine — the demo still works.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- Database (SQLite default; any PostgreSQL DSN works) -------------------
DATABASE_URL=sqlite:///./kaushal_saathi.db

# ---- Misc -----------------------------------------------------------------
CORS_ORIGINS=*
